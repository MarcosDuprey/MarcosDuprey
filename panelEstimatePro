/* ==========================================================
   9. DOCUMENT LOCK SYSTEM
   ----------------------------------------------------------
   Locks form fields after client signature
   to prevent estimate tampering.

   Unlocking removes QR verification.
   ========================================================== */

function lockDocument(lock) {

  const elements = form.querySelectorAll("input, select, button, textarea");

  elements.forEach(el => {

    // Never disable Print or Email here (controlled separately)
    if (el.id === "printBtn" || el.id === "emailEstimateBtn") return;

    // Never disable the accept checkbox itself (so it can be unchecked if needed)
    if (el.id === "clientAccept") return;

    if (lock) {
      el.setAttribute("disabled", "true");
      el.style.opacity = "0.85";
    } else {
      el.removeAttribute("disabled");
      el.style.opacity = "1";
    }
  });

  // Lock signature pad drawing
  if (lock) {
    canvas.style.pointerEvents = "none";
  } else {
    updateSignatureLock();
  }

}	
	
/* ==========================================================
   10. QR VERIFICATION SYSTEM
   ----------------------------------------------------------
   Generates a SHA-256 verification hash and embeds it
   inside a QR code printed on the estimate.

   Used to verify document authenticity.
   ========================================================== */
	
async function generateQRCode(){

  const qrContainer = document.getElementById("qrContainer");
  qrContainer.innerHTML = "";

  if(!hasSignature || !clientAccept.checked){
    return;
  }

  const estimateNumber = document.getElementById("estimateNumber").textContent;
  const total = totalField.textContent;
  const client = document.getElementById("clientName").value;
  const date = document.getElementById("estimateDate").value;

  const rawData = `
${estimateNumber}|
${client}|
${total}|
${date}|
${serviceSize.value}|
${grounding.checked}|
${surge.checked}|
${serviceEntrance.checked}|
${document.getElementById("companyName").value}|
${document.getElementById("licenseNumber").value}|
SIGNED
`.trim();

  const fullHash = await generateHash(rawData);

  // Store full hash hidden
  document.getElementById("estimateHash").value = fullHash;

  // Show short visible hash (first 10 chars)
  let shortHashEl = document.getElementById("visibleHash");

  if(!shortHashEl){
    shortHashEl = document.createElement("div");
    shortHashEl.id = "visibleHash";
    shortHashEl.style.fontSize = "11px";
    shortHashEl.style.marginTop = "4px";
    document.getElementById("qrContainer").appendChild(shortHashEl);
  }

  shortHashEl.innerHTML = "Verification ID: " + fullHash.substring(0,10).toUpperCase();

  new QRCode(qrContainer, {
    text: `
Estimate: ${estimateNumber}
Client: ${client}
Total: ${total}
Date: ${date}
Verification: ${fullHash}
    `.trim(),
    width: 100,
    height: 100
  });

}

/* ==========================================================
   11. TAMPER DETECTION
   ----------------------------------------------------------
   Recalculates the estimate hash and compares it with
   the stored verification value.

   If mismatch occurs:

   • status becomes TAMPERED
   • printing disabled
   • emailing disabled
   ========================================================== */
	
async function verifyIntegrity(){

  if(!hasSignature || !clientAccept.checked){
    return true;
  }

  const estimateNumber = document.getElementById("estimateNumber").textContent;
  const total = totalField.textContent;
  const client = document.getElementById("clientName").value;
  const date = document.getElementById("estimateDate").value;

  const rawData = `
${estimateNumber}|
${client}|
${total}|
${date}|
${serviceSize.value}|
${grounding.checked}|
${surge.checked}|
${serviceEntrance.checked}|
${document.getElementById("companyName").value}|
${document.getElementById("licenseNumber").value}|
SIGNED
`.trim();

  const newHash = await generateHash(rawData);
  const storedHash = document.getElementById("estimateHash").value;

  if(newHash !== storedHash){

    const badge = document.getElementById("statusBadge");

    badge.textContent = "TAMPERED";
    badge.style.background = "#b91c1c";
    badge.style.color = "#fff";

    printBtn.disabled = true;
    emailBtn.disabled = true;

    document.getElementById("qrContainer").innerHTML = "";

    return false;
  }

  return true;
}

/* ==========================================================
   12. PDF GENERATION
   ----------------------------------------------------------
   Converts the estimate container to a printable PDF
   using html2canvas and jsPDF libraries.
   ========================================================== */
	
async function generatePDF(){

  const { jsPDF } = window.jspdf;

  const element =
    document.getElementById("estimateContainer");

  const canvas =
    await html2canvas(element,{scale:2});

  const imgData =
    canvas.toDataURL("image/png");

  const pdf = new jsPDF("p","mm","letter");

  const pageWidth = pdf.internal.pageSize.getWidth();

  const imgWidth = pageWidth - 20;
  const imgHeight = canvas.height * imgWidth / canvas.width;

  pdf.addImage(
    imgData,
    "PNG",
    10,
    10,
    imgWidth,
    imgHeight
  );

  const estimateNumber =
    document.getElementById("estimateNumber").textContent;

  pdf.save(`Estimate-${estimateNumber}.pdf`);

}

