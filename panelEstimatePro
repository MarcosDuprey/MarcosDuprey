/* ================= SAVE ESTIMATE ================= */
function saveEstimate(){

  const estimateNumber = document.getElementById("estimateNumber").textContent;

  const estimateData = {
    estimateNumber,
    date: document.getElementById("estimateDate").value,
    client: document.getElementById("clientName").value,
    total: totalField.textContent,
    hash: document.getElementById("estimateHash").value,
    signed: true,
    timestamp: Date.now()
  };

  // Save individual record
  localStorage.setItem(
    "estimate_" + estimateNumber,
    JSON.stringify(estimateData)
  );

  // Save master list
  let approved = JSON.parse(localStorage.getItem("approvedEstimates")) || [];

  // Prevent duplicates
  approved = approved.filter(e => e.estimateNumber !== estimateNumber);

  approved.push(estimateData);

  localStorage.setItem("approvedEstimates", JSON.stringify(approved));
}


