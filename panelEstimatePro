function updateDashboardStats(){
	const database = JSON.parse(localStorage.getItem("approvedEstimates")) || [];

	let totalEstimates = database.length;
	let approvedJobs = database.length;
	let revenue = 0;

	database.forEach(job=>{
 		revenue += parseFloat(job.total || 0);
});

	let conversion = 0;

	if(totalEstimates > 0){
 		conversion = Math.round((approvedJobs / totalEstimates) * 100);
}

document.getElementById("statEstimates").innerText = totalEstimates;
document.getElementById("statApproved").innerText = approvedJobs;
document.getElementById("statRevenue").innerText = "$" + revenue.toFixed(2);
document.getElementById("statConversion").innerText = conversion + "%";

}


