  document.getElementById("estimateNumber").textContent = est.estimateNumber;
  document.getElementById("estimateDate").value = est.date;
  document.getElementById("clientName").value = est.client;
  totalField.textContent = est.total;

  document.getElementById("estimateHash").value = est.hash;

  hasSignature = true;
  clientAccept.checked = true;

  updateUIState();
  generateQRCode();
}


/* ====== DELETE DASHBOARD ESTIMATE ====== */
function deleteEstimate(index){

  if(!confirm("Delete this estimate?")) return;

  let estimates =
    JSON.parse(localStorage.getItem("approvedEstimates")) || [];

  const removed = estimates.splice(index, 1);

  localStorage.setItem(
    "approvedEstimates",
    JSON.stringify(estimates)
  );

  if(removed.length){
    localStorage.removeItem("estimate_" + removed[0].estimateNumber);
  }

  renderSavedEstimates();
}


