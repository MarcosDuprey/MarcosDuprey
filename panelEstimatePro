/* ==========================================================
   5. ESTIMATE NUMBER SYSTEM
   ----------------------------------------------------------
   Generates unique estimate numbers.

   Format:
   QTE-YYMMDD-###
   Example:
   QTE-240315-001

   Stored in localStorage to prevent duplicates.
   ========================================================== */

function generateEstimateNumber(){

const today = new Date();

const datePart =
today.getFullYear().toString().slice(-2) +
String(today.getMonth()+1).padStart(2,"0") +
String(today.getDate()).padStart(2,"0");

let registry = JSON.parse(localStorage.getItem("dailyEstimateRegistry")) || {};

const dateKey = today.toISOString().split("T")[0];

if(!registry[dateKey]){
registry[dateKey] = [];
}

let number = 1;

while(registry[dateKey].includes(number)){
number++;
}

registry[dateKey].push(number);

localStorage.setItem("dailyEstimateRegistry",JSON.stringify(registry));

document.getElementById("estimateNumber").textContent =
`QTE-${datePart}-${String(number).padStart(3,'0')}`;

}


/* ==========================================================
   6. PRICING ENGINE
   ----------------------------------------------------------
   Calculates project cost based on:

   • selected panel size
   • material markup
   • labor hours
   • NEC upgrade options
	
		API to detects prices on local electrical stores, HomeDepot, GrayBar, or compatibles stores.
	 It must dects material prices from stores on PR, FL, PA, CA
	========================================================== */
	
function calculatePricing(){

  if(!serviceSize.value){
    materialsCost.textContent = money(0);
    laborCost.textContent = money(0);
    permitsCost.textContent = money(0);
    
		totalField.textContent = "--";
    return;
  }

  const data = CONFIG.serviceDB[serviceSize.value];

  const material = data.material * CONFIG.markup;
  const labor = data.laborHours * CONFIG.laborRate;

  materialsCost.textContent = money(material);
  laborCost.textContent = money(labor);
  permitsCost.textContent = money(CONFIG.permits);

  calculateTotal();
}

function calculateTotal(){

  const material = parseFloat(materialsCost.textContent.replace(/[^0-9.]/g,"")) || 0;
  const labor = parseFloat(laborCost.textContent.replace(/[^0-9.]/g,"")) || 0;

  const upgradeTotal =
    (grounding.checked ? CONFIG.upgrades.grounding : 0) +
    (surge.checked ? CONFIG.upgrades.surge : 0) +
    (serviceEntrance.checked ? CONFIG.upgrades.serviceEntrance : 0);

  groundingCost.textContent = money(grounding.checked ? CONFIG.upgrades.grounding : 0);
  surgeCost.textContent = money(surge.checked ? CONFIG.upgrades.surge : 0);
  serviceEntranceCost.textContent = money(serviceEntrance.checked ? CONFIG.upgrades.serviceEntrance : 0);

  totalField.textContent = money(
    material + labor + CONFIG.permits + upgradeTotal
  );
}

