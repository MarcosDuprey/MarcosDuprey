<style>
/* =====================================================
   PANEL ESTIMATE PRO — CORE STYLESHEET
   Organized: Base → Layout → Components → Header → 
              Signature → Tables → Actions → Print
===================================================== */

/* ================================
   1. GLOBAL / RESET
================================ */
:root {
  --primary: #0f766e;
  --primary-dark: #115e59;
  --bg-soft: #f1f5f9;
  --border-soft: #e5e7eb;
  --success: #16a34a;
  --warning: #fbbf24;
}

html {
  scroll-padding-top: 80px; /* adjust to header height */
	scroll-behavior: smooth;
}
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: #1f2937;
	background: #f1f5f9;
}

label {
  font-weight: 600;
  font-size: 14px;
}
.container {
  max-width: 950px;
  margin: auto;
  background: #ffffff;
  padding: 35px;
	margin-bottom:10px;
  border-radius: 12px;
  box-shadow: 0 25px 60px rgba(0,0,0,0.08);
}
section {
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:10px;
  padding:18px;
  margin-bottom:24px;
}


/* ================================
   2. TYPOGRAPHY
================================ */

h2 {
  color:var(--primary);
	padding:0px;
	margin:0px;
}

/* ================================
   3. FORM ELEMENTS
================================ */

input, select {
  padding: 8px 10px;
  border-radius: 6px;
  margin-bottom: 12px;
	border: 1px solid #d1d5db;
  transition: border 0.2s ease;
}

input:focus, select:focus {
  outline: none;
  border-color: #0f766e;
}

/*-- CLIENT Information --*/
.form-row{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

.form-row input,
.form-row select{
  flex:1;
  min-width:120px;
}

#estimateDate,
#signatureDate {
  width: 40%;
  padding: 0 5px;
}


/* ================================
   4. HEADER (DOCUMENT HEADER)
================================ */

 .workflow{
  text-align:center;
  font-size:13px;
  color:#64748b;
  margin-top:5px;
	margin-bottom:5px;
}			

.header {
    display: flex;
    justify-content: space-between;
    padding-bottom: 15px;
}

.header-container {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
}

.header-left {
  flex: 1;
}

.header-right {
  text-align: right;
  min-width: 260px;
}

.meta-block div {
  margin-bottom: 6px;
}

.qr-box {
  margin-top: 10px;
}

.promoBox {
  margin-top: 15px;
  font-size: 12px;
  border-top: 1px solid #ddd;
  padding-top: 10px;
  padding: 8px;
  border: 1px dashed #9ca3af;
  background: #f9fafb;
  text-align: center;
} 

.company, .meta { font-size: 14px; line-height: 1.6; }
.meta { text-align: right; }

#estimateNumber	{
color:#555;
}


/* ================================
   STATUS BADGE
================================ */

.statusBadge {
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .5px;
  display: inline-block;
  margin-top: 10px;
  transition: all .3s ease;
}

.statusBadge.draft {
  background: #fbbf24;
  color: #000;
}

.statusBadge.signed {
  background: #16a34a;
  color: #fff;
}

.statusBadge.tampered {
  background: #b91c1c;
  color: #fff;
}

/* ================================
   PANEL SELECTION CARDS
================================ */

.panel-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 15px;
  margin-top: 15px;
}

/* PERFORMANCE MICRO FIXES */
.panel-card{
 will-change: transform;
}
.panel-card {
  padding: 20px;
  border: 2px solid #d1d5db;
  border-radius: 8px;
  text-align: center;
  cursor: pointer;
  background: #f9fafb;
  transition: all 0.25s ease;
  transition: transform .15s ease, box-shadow .15s ease;
}

.panel-card:hover{
  box-shadow:0 4px 12px rgba(0,0,0,.15);
  border-color: #0f766e;
  transform: translateY(-2px);
}

.panel-card.active {
  border-color: #0f766e;
  background: #ecfeff;
  box-shadow: 0 0 10px rgba(15,118,110,0.3);
	transform: translateY(-3px) scale(1.02);

}

.panel-card.selected{
  border:3px solid #00897b;
  background:#e0f2f1;
}

.panel-card h3 {
  margin: 0;
  font-size: 18px;
}

.panel-card p {
  margin: 6px 0 0;
  font-size: 12px;
  color: #555;
}

.locked .panel-card{
  opacity:.6;
  pointer-events:none;
}

p.sectionHint		{
 	font-size:12px;
	color:#555;
	margin-top:8px;
}


/* ================================
   SCOPE OF WORK BOX
================================ */

.scope-box{
  margin-top:20px;
  padding:18px;
  border:2px solid #0f766e;
  background:#f0fdfa;
  border-radius:8px;
}

.scope-box h3{
  margin-top:0;
  margin-bottom:10px;
  color:#0f766e;
}

.scope-box ul{
  padding-left:18px;
  margin:0;
}

.scope-box li{
  margin-bottom:6px;
  font-size:14px;
}


/* ================================
   5. OPTIONS / UPGRADE BOXES
================================ */

.option {
  margin-top: 15px;
  padding: 12px;
  background: #f9fafb;
  border: 1px solid #d1d5db;
}


/* ================================
   6. COST TABLE
================================ */

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
}
table tr td:nth-child(2) {
		text-align:center;
		}
td {
    border: 1px solid #d1d5db;
    padding: 10px; 
		font-size: 14px;
		}
		
th {
	border: 1px solid #d1d5db;
  background: #f1f5f9;
	font-weight: bold;
  font-size: 20px; 
}
.total{
  font-size:24px;
  color:var(--primary);
	background: #f1f5f9;
}

/* ================================
   7. SIGNATURE SECTION
================================ */

#signatureSection{
  border:2px solid var(--primary);
  background:#f8fffe;
}

#signaturePad {
  border: 1px solid #000;
  width: 100%;
  height: 150px;
	background:#fff;
  touch-action: none;
	cursor:crosshair;
}

.signature {
  margin-top: 40px;
  display: flex;
  justify-content: space-between;
}

.signature div {
  width: 45%;
  border-top: 1px solid #000;
  padding-top: 5px;
}
.clearSignature {
  margin: 0;
}


/* ================================
   8. ACTION BUTTONS
================================ */

button {
  padding: 10px 20px;
  background: #0f766e;
  color: white;
  border: none;
  cursor: pointer;
  font-size: 14px;
}

button:hover {
  background: #115e59;
  transform: translateY(-1px);
}

button:active {
  transform: scale(0.97);
}

button:disabled {
  background: #9ca3af;
  cursor: not-allowed;
}

/*===== SCROLLMENU =====*/
div.scrollmenu {
  background-color: transparent;
  padding: 10px;
  overflow-x: auto;
  white-space: nowrap;
}

#menuSection{
  background:#fff;
  border-top:1px solid var(--border-soft);
  padding:10px 0;
}

.primary-btn {
  background:#16a34a;
}

.secondary-btn {
  background:#0f766e;
}

.danger-btn {
  background:#b91c1c;
}


/* ================================
   9. APP HEADER (TOP NAV)
================================ */

.app-header {
  position: sticky;
  top: 0;
  z-index: 1000;

  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 1.5rem;

  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(3px);
  border-bottom: 1px solid rgba(0,0,0,0.08);
}

.brand {
  font-family: "Bebas Neue", sans-serif;
  font-size: 1.8rem;
}

.theme-toggle {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

/* ================================
   10. THEME TOGGLE SWITCH
================================ */

.switch {
  position: relative;
  width: 46px;
  height: 24px;
  display: inline-block;
}

.switch input {
  opacity: 0;
  width: 0;
  height: 0;
}

.slider {
  position: absolute;
  cursor: pointer;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: #767676;
  transition: 0.3s;
  border-radius: 24px;
}

.slider::before {
  content: "";
  position: absolute;
  height: 18px;
  width: 18px;
  left: 3px;
  bottom: 3px;
  background-color: white;
  transition: 0.3s;
  border-radius: 50%;
}

input:checked + .slider {
  background-color: #0f766e;
}

input:checked + .slider::before {
  transform: translateX(22px);
}

/* ================================
   11. PRINT CHECKBOX VISUAL LOCK
================================ */

.print-mark {
  display: none;
  font-weight: bold;
  margin-left: 8px;
}

/* ================================
   12. PRINT MODE
================================ */

@media print {

 .app-header,
 .no-print,
 .actionBar,
	button {	
		display:none !important;
 }

  body {
		margin:12mm;
    background: #ffffff !important;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .container {
    box-shadow: none !important;
    margin: 0 !important;
    border: 1px solid #000;
    padding: 20px;
  }

  h2 {
    color: #000;
  }
	
  select {
    border: none !important;
    padding: 0 !important;
    appearance: none;
    -webkit-appearance: none;
    background: transparent !important;
    color: #000 !important;
    pointer-events: none;
  }

  input[type="checkbox"] {
    display: none !important;
  }

  .print-mark {
    display: inline !important;
    font-size: 16px;
  }

  #signaturePad {
    border: none !important;
  }
}

.actionBar {
  display: none !important;
}

/* ================================
   13. RESPONSIVE 
================================ */

@media (max-width: 768px) {

  .header-container {
    flex-direction: column;
  }

  .header-right {
    text-align: left;
    margin-top: 15px;
  }

}

/* ================================
   DELETE ROW with ANIMATION
================================ */

.deleteRow {
  animation: rowDelete 0.35s ease forwards;
}

@keyframes rowDelete {
  0% {
    opacity: 1;
    transform: translateX(0);
  }
  100% {
    opacity: 0;
    transform: translateX(-40px);
    height: 0;
  }
}

@keyframes fadeDelete {
  0% {
    opacity: 1;
    transform: translateX(0);
  }
  100% {
    opacity: 0;
    transform: translateX(-60px);
  }
}

.removing {
  animation: fadeDelete 0.35s forwards;
}

/* ================================
   14. TOAST
================================ */

.toast {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: #111;
  color: #fff;
  padding: 12px 18px;
  border-radius: 6px;
  opacity: 0;
  transition: opacity .3s ease;
  z-index: 5000;
}
.toast.show {
  opacity: 1;
}


/* ================================
   DASHBOARD MODAL
================================ */

.dashboard-modal{
	position:fixed;
	top:80px;
	left:0;
	width:90%;
	height:80%;
	background:white;
	overflow:auto;
	padding:20px;
	z-index:999;
	display:none;
}

.dashboard-stats{
	display:grid;
	grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
	gap:15px;
	margin-bottom:40px;
}

.stat-card{
	background:#f4f4f4;
	padding:15px;
	border-radius:10px;
	text-align:center;
}

.stat-card h3{
	margin-bottom:8px;
	font-size:14px;
}

.stat-card p{
	font-size:22px;
	font-weight:bold;
}

.dashboard-table{
	width:100%;
	border-collapse:collapse;
}

.dashboard-table th,
.dashboard-table td{
	border-bottom:1px solid #ddd;
	padding:8px;
	text-align:left;
}

.dashboard-table button{
	padding:6px 10px;
}

/* ================================
   NEW VERSION NOTIFICATION UPDATE
	================================ */

.updateNotice{
  position:fixed;
  top:10px;
  left:50%;
  transform:translateX(-50%);
  background:#0f766e;
  color:white;
  padding:10px 18px;
  border-radius:8px;
  display:none;
  z-index:9999;
}

</style>

</head>

