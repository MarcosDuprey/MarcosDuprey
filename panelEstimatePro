/* -- Convert Estimate → Job
When client signs and accepts: 
----------------------------------------- */
function approveEstimate(estimateID){
	const db = getDB();
	const est = db.estimates.find(e=>e.id===estimateID);

	if(!est) return;

	est.status = "approved";

	const job = {

		id: Date.now(),
		estimateID: est.id,
		client: est.client,
		total: est.total,
		status:"scheduled"
};

	db.jobs.push(job);
	saveDB(db);
}

/* -- Invoice Generator	
Create an invoice automatically after approval.
------------------–------------------------------------------ */
function createInvoice(jobID){
	const db = getDB();
	const job = db.jobs.find(j=>j.id===jobID);

	if(!job) return;
	const invoice = {

		id: Date.now(),
		jobID: job.id,
		client: job.client,
		amount: job.total,
		paid:0,
		balance: job.total,
		date: new Date().toISOString()
};

db.invoices.push(invoice);

saveDB(db);
}

/* -- Payment Tracking
Record customer payments.
---------------------------------- -- */
function recordPayment(invoiceID,amount){
	const db = getDB();
	const invoice = db.invoices.find(i=>i.id===invoiceID);

	if(!invoice) return;
	invoice.paid += amount;
	invoice.balance -= amount;
	db.payments.push({

		id:Date.now(),
		invoiceID,
		amount,
		date:new Date().toISOString()
});

saveDB(db);

}

